{
  "name": "@local/dsh-exchange",
  "version": "1.4.0",
  "description": "Mail Assistant \u2014 Microsoft Exchange (EWS + NTLM) plugin for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": "0.2.3-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/**/*.js",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "dependencies": {
    "@ewsjs/xhr": "^3.1.3",
    "ews-javascript-api": "0.15.3",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-error": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-error": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}

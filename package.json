{
  "name": "@local/dsh-exchange",
  "version": "1.1.0",
  "description": "Mail Assistant — Microsoft Exchange (EWS + NTLM) plugin for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/**/*.js",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "dependencies": {
    "@ewsjs/xhr": "^3.1.3",
    "ews-javascript-api": "0.15.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-error": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-error": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}

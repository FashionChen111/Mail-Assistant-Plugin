{
  "name": "@local/dsh-exchange",
  "version": "1.4.0",
  "description": "Mail Assistant — Microsoft Exchange (EWS + NTLM) plugin for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.0-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "dist/ews.cjs",
    "dist/ews-notices.txt",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/**/*.js",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "prepare": "node scripts/build-ews.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "esbuild": "0.28.2",
    "ews-javascript-api": "0.15.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
